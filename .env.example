# ---------------------------------------------------------------------------
# Rangverse environment template
#
# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API), or from `supabase status` when running
# the local stack.
#
# NEVER commit a filled-in copy of this file. .env* is gitignored apart from
# this template.
# ---------------------------------------------------------------------------

# Public: safe to expose to the browser. Row level security still applies to
# every request made with the publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-anon-key

# The origin the app is served from. Used to build password-reset and
# invitation links, so it must match your deployment exactly.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. This key bypasses row level security.
#   * never prefix it with NEXT_PUBLIC_
#   * never reference it from a client component
#   * store it as a secret in CI and in your hosting provider
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Optional: set to the base URL of a running Rangverse instance to let the
# authenticated Playwright suite run. Leave unset and those specs skip with an
# explicit reason rather than being reported as passed.
# E2E_BASE_URL=http://localhost:3000
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
